# 复制为 .env 并填写。所有项都有命令行等价参数，可不填。

# B 站登录态 cookie 串（拿 AI 字幕 / BCUT 转写必需）
# 格式示例: SESSDATA=xxx; ...
BILIBILI_COOKIE=

# Netscape 格式 cookie 文件路径（与 BILIBILI_COOKIE 二选一）
BILIBILI_COOKIE_FILE=

# 输出目录默认值
BILIBILI_OUTPUT=./bilibili_out

# ---- 以下仅在 --note 时生效 ----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini